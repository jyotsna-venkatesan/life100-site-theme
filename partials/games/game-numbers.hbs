<script>
window.GAMES = window.GAMES || {};

window.GAMES['number-match'] = {
  title: 'Number Match',
  desc: 'Memorize a 10-digit phone number, then type it from memory.',
  max: 10,
  icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  study: 'Memorize this phone number!',
  prompt: 'Type the 10-digit number you saw',
  placeholder: '(555) 123-4567 or 5551234567',
  multiline: false,
  generate() {
    return `${Math.floor(100 + Math.random() * 900)}${Math.floor(100 + Math.random() * 900)}${Math.floor(1000 + Math.random() * 9000)}`;
  },
  format(n) { return `(${n.slice(0, 3)}) ${n.slice(3, 6)}-${n.slice(6)}`; },
  render(n) { return `<div class="g-phone">${this.format(n)}</div>`; },
  score(n, input) {
    const d = input.replace(/\D/g, '');
    let c = 0;
    for (let i = 0; i < 10; i++) if (d[i] && d[i] === n[i]) c++;
    return c;
  },
  breakdown(n, input) {
    const d = input.replace(/\D/g, '');
    const digits = n.split('').map((ch, i) => `<span class="g-digit ${d[i] === ch ? 'hit' : 'miss'}">${ch}</span>${(i === 2 || i === 5) ? '<span class="g-digit sep"></span>' : ''}`).join('');
    return `
      <div class="g-breakdown-row">
        <h3>The number (green = correct position)</h3>
        <div class="g-tags" style="gap:4px;">${digits}</div>
      </div>
      <div class="g-breakdown-row">
        <h3>What you typed</h3>
        <div class="g-typed">${input.trim() ? esc(input) : '(Nothing entered)'}</div>
      </div>`;
  }
};
</script>