<script>
window.GAMES = window.GAMES || {};

(function () {
  const PER_ROUND = 3;
  const SEEN_KEY = 'riddles_seen_';

  /* Built-in riddles: used until your Ghost page has 3+ riddles for a level */
  const BUILT_IN = {
    1: [
      { q: "A farmer has 5 daughters. Each daughter has a brother. How many children does the farmer have?",
        a: "Six: five daughters and one son.", why: "They all share the same brother." },
      { q: "A plane crashes on the border between two countries. Where do they bury the survivors?",
        a: "Nowhere. Survivors are alive.", why: "You don't bury survivors." },
      { q: "You walk into a dark room with a candle, an oil lamp and a fireplace, and only one match. What do you light first?",
        a: "The match.", why: "Nothing else can be lit until it is." }
    ],
    2: [
      { q: "Three switches outside a closed room control three bulbs inside. You may enter the room only once. How do you tell which switch runs which bulb?",
        a: "Leave one switch on for a while, turn it off, switch on another, then go in and feel the bulbs.",
        why: "Lit means the second switch, warm means the first, cold means the third." },
      { q: "A clock strikes 6 in 30 seconds. How long does it take to strike 12?",
        a: "66 seconds.", why: "6 strikes have 5 gaps of 6 seconds. 12 strikes have 11 gaps." },
      { q: "A lorry is 2 cm too tall for a low bridge and can't reverse. What can the driver do?",
        a: "Let some air out of the tyres.", why: "That lowers the lorry by a few centimetres." }
    ],
    3: [
      { q: "A man looks at a photograph. \"Brothers and sisters, I have none. But that man's father is my father's son.\" Who is in the photo?",
        a: "His own son.", why: "\"My father's son\" is himself, so the man in the photo is his son." },
      { q: "A man jumps from a plane without a parachute and lives. How?",
        a: "The plane was on the ground.", why: "Nobody said it was flying." },
      { q: "A boat has a ladder with 5 rungs showing above the water. The tide rises 1 metre. How many rungs are underwater now?",
        a: "None.", why: "The boat rises with the tide." }
    ]
  };

  /* ---------- Reading riddles from the Ghost page /game-riddles/ ----------
     Format on the page:
       ## Level 1
       ### The riddle question
       Answer: the answer
       Why: optional one-line explanation                                   */
  let FROM_PAGE = { 1: [], 2: [], 3: [] };

  function htmlToLines(root) {
    let out = '';
    const walk = n => {
      if (n.nodeType === 3) { out += n.nodeValue; return; }
      if (n.nodeType !== 1) return;
      const t = n.tagName;
      if (t === 'BR') { out += '\n'; return; }
      if (/^H[1-6]$/.test(t)) { out += '\n# '; n.childNodes.forEach(walk); out += '\n'; return; }
      const block = /^(P|DIV|UL|OL|LI|BLOCKQUOTE)$/.test(t);
      if (block) out += '\n';
      n.childNodes.forEach(walk);
      if (block) out += '\n';
    };
    walk(root);
    return out.split('\n').map(s => s.replace(/\s+/g, ' ').trim()).filter(Boolean);
  }

  function parsePage(root) {
    const found = { 1: [], 2: [], 3: [] };
    let level = 0, cur = null, last = null;
    const finish = () => {
      if (cur && level && cur.q && cur.a) found[level].push(cur);
      cur = null; last = null;
    };
    htmlToLines(root).forEach(line => {
      const lv = line.match(/^#+\s*level\s*([123])\b/i);
      if (lv) { finish(); level = +lv[1]; return; }
      if (/^#+\s+/.test(line)) { finish(); cur = { q: line.replace(/^#+\s+/, ''), a: '', why: '' }; last = 'q'; return; }
      if (!cur) return;
      let m;
      if ((m = line.match(/^answer:\s*(.*)$/i))) { cur.a = m[1]; last = 'a'; }
      else if ((m = line.match(/^why:\s*(.*)$/i))) { cur.why = m[1]; last = 'why'; }
      else if (/^(hint|trap):/i.test(line)) { last = null; }
      else if (last) { cur[last] += ' ' + line; }
    });
    finish();
    return found;
  }

  (async function sync() {
    try {
      const res = await fetch('/game-riddles/');
      if (!res.ok) return;
      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      const root = doc.querySelector('.gh-content, .post-content, .content, article, main') || doc.body;
      FROM_PAGE = parsePage(root);
    } catch (e) { /* keep built-in riddles */ }
  })();

  const store = {
    get(k) { try { return JSON.parse(localStorage.getItem(k) || '[]'); } catch (e) { return []; } },
    set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
  };

  function chooseRound(lvl) {
    const pool = FROM_PAGE[lvl].length >= PER_ROUND ? FROM_PAGE[lvl] : BUILT_IN[lvl];
    const key = SEEN_KEY + lvl;
    let seen = store.get(key);
    let fresh = pool.filter(r => seen.indexOf(r.q) === -1);
    if (fresh.length < PER_ROUND) { seen = []; fresh = pool.slice(); }
    const round = shuffle(fresh.slice()).slice(0, PER_ROUND);
    store.set(key, seen.concat(round.map(r => r.q)));
    return round;
  }

  window.GAMES['riddles'] = {
    title: 'Clever Riddles',
    desc: 'Puzzles where the obvious answer is a trap.',
    max: PER_ROUND,
    interactive: true,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z"/><path d="M9 21h6"/></svg>',
    study: 'Think it through, then check your answer.',
    levelSub: 'Pick how tricky the riddles get.',
    levelNote: l => ['Clear clues', 'Physical & sequential logic', 'Counter-intuitive mind benders'][l - 1],
    unlockAt: 2,

    start(stage, lvl, done) {
      const round = chooseRound(lvl);
      const total = round.length;
      let index = 0, score = 0;
      const results = [];

      const footer = document.querySelector('.g-play-footer');
      if (footer) footer.style.display = 'flex';

      function show() {
        const r = round[index];
        stage.innerHTML =
          '<div class="rd-wrap">' +
          '<p class="rd-count">' + (index + 1) + ' / ' + total + '</p>' +
          '<p class="rd-q">' + esc(r.q) + '</p>' +
          '<div class="rd-bottom" id="rd-bottom">' +
          '<button type="button" class="g-btn g-btn-orange g-btn-lg" id="rd-show">Show answer</button>' +
          '</div></div>';
        stage.querySelector('#rd-show').addEventListener('click', () => reveal(r));
      }

      function reveal(r) {
        const bottom = stage.querySelector('#rd-bottom');
        bottom.innerHTML =
          '<div class="rd-answer"><p class="rd-a">' + esc(r.a) + '</p>' +
          (r.why ? '<p class="rd-why">' + esc(r.why) + '</p>' : '') + '</div>' +
          '<p class="rd-ask">Did you get it?</p>' +
          '<div class="rd-score"><button type="button" class="rd-yes" id="rd-yes">&#10003; Got it</button>' +
          '<button type="button" class="rd-no" id="rd-no">&#10007; Missed it</button></div>';
        const next = ok => {
          if (ok) score++;
          results.push({ q: r.q, ok });
          index++;
          if (index < total) show(); else finish();
        };
        bottom.querySelector('#rd-yes').addEventListener('click', () => next(true));
        bottom.querySelector('#rd-no').addEventListener('click', () => next(false));
      }

      function finish() {
        const tags = results.map((x, i) =>
          '<span class="g-tag ' + (x.ok ? 'hit' : 'miss') + '">' + (x.ok ? '&#10003;' : '&#10007;') + ' Riddle ' + (i + 1) + '</span>').join('');
        done(score, '<div class="g-breakdown-row"><div class="g-tags">' + tags + '</div></div>');
      }

      show();
    }
  };
})();
</script>
