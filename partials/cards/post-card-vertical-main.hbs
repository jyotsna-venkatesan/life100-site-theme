<article class="{{post_class}} {{card_class}} relative flex flex-col gap-4 text-typ" data-post-card{{#if featured}} data-featured{{/if}}>
  {{!-- Feature Image --}}
  {{#if feature_image}}
    <a href="{{url}}" class="relative group {{media_class}}">
      <figure class="block rounded-theme overflow-hidden" role="none">
        {{> image
          image_type="post"
          image_class="aspect-[3/2] object-cover rounded-[inherit] w-full group-hover:opacity-90 transition-opacity"
          image_url=feature_image
          size_s=true
          size_m=true
          size_l=true
          sizes="(max-width: 767px) 90vw, (max-width: 1200px) 50vw, 720px"
          loading="eager"
        }}        
        {{> post-card-type-icon wrapper_class="scale-200 md:scale-300"}}
      </figure>
    </a>
  {{/if}}

  {{!-- justify-center vertically centres the text in the white box; pt-8 / lg:pt-12 adds generous space above content --}}
  <div class="bg-bgr flex-1 flex flex-col justify-center gap-2.5 pt-8 pb-6{{#if feature_image}} lg:pl-8 lg:ml-16 lg:-mt-14 lg:pt-12 lg:pb-6 z-10{{/if}}" data-post-card-content>

    {{!-- Post meta: tag / visibility / comment count --}}
    {{#has tag="#top-story"}}
      <span class="inline-block self-start mt-2 mb-1 ml-1 text-sm uppercase font-semibold font-sans bg-transparent text-brand-contrast py-1 px-2.5 relative before:absolute before:inset-0 before:bg-brand before:rounded-theme before:z-[-1] before:skew-x-[-15deg]" data-top-story>{{t "Top Story"}}</span>
    {{else}}
      {{> post-card-meta-top element_class="mt-2 mb-1"}}
    {{/has}}

    {{!-- Title --}}
    <h1 class="text-xl font-semibold md:text-2xl lg:text-3xl xl:text-4xl" data-post-card-title>
      <a href="{{url}}" class="hover:underline underline-offset-4 inline-flex gap-2 items-start">
        <span>{{title}}</span>
      </a>
    </h1>

    {{!-- Excerpt --}}
    {{#if excerpt}}
      <p class="text-base leading-normal md:text-lg mb-0.5 text-balance {{excerpt_class}}" data-post-card-excerpt>
        {{excerpt words="30"}}
      </p>
    {{/if}}

    {{!-- Post meta: authors and date --}}
    {{> post-card-meta-bottom }}

    {{!-- Read More button (centred, orange button style) --}}
    <a href="{{url}}" class="self-center mt-3 inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-lg bg-[#fc9504] text-[#1b1000] text-sm font-bold uppercase tracking-tight no-underline shadow-[0_3px_0_#d97f00] hover:bg-[#ffa404] active:translate-y-[2px] active:shadow-none transition-all">
      {{t "Read More"}}
      <span aria-hidden="true">→</span>
    </a>
    
  </div>
</article>