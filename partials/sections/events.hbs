{{#if @custom.show_events}}
  <section class="px-5 sm:px-6 mt-20" data-events>
    <div class="max-w-site mx-auto">
      {{> section-heading 
        section_title=(t "Editor's Picks")
      }}
      <div class="grid gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6">
        
        {{!-- Card 1: Longevity --}}
        <a href="https://6090-club.ghost.io/events/longevity/" class="flex flex-col gap-3 group hover:opacity-90 transition-opacity">
          <figure class="block rounded-theme overflow-hidden bg-[#eadecc]">
            <img data-asset-key="card-longevity" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 9'%3E%3C/svg%3E" alt="Longevity" class="w-full aspect-[16/9] object-cover rounded-[inherit] transition-transform duration-300 group-hover:scale-105" loading="lazy">
          </figure>
          <h3 class="text-base font-semibold md:text-lg leading-tight">Longevity</h3>
        </a>

