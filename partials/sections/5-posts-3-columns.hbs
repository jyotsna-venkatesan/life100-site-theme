<div class="max-w-site mx-auto flex flex-col gap-5 lg:flex-row">
  {{!-- Center/main post (switch via Ghost Admin using the #top-story tag) --}}
  {{#foreach top_story_posts}}
  {{> cards/post-card-vertical-main 
  card_class="flex-2 pb-5 border-b border-brd-soft lg:pb-0 lg:border-b-0 lg:px-5 lg:border-x text-center [&_[data-post-card-content]]:pt-0! [&_[data-post-card-content]]:px-4! [&_[data-post-card-content]]:m-0! [&_[data-post-card-content]]:items-center [&_[data-top-story]]:self-center"
  excerpt_class="line-clamp-3 md:line-clamp-4"
  image_loading="eager"
  }}
  {{/foreach}}
  {{#unless top_story_posts.length}}
  {{#foreach hero_posts from="1" to="1"}}
  {{> cards/post-card-vertical-main 
  card_class="flex-2 pb-5 border-b border-brd-soft lg:pb-0 lg:border-b-0 lg:px-5 lg:border-x text-center [&_[data-post-card-content]]:pt-0! [&_[data-post-card-content]]:px-4! [&_[data-post-card-content]]:m-0! [&_[data-post-card-content]]:items-center"
  excerpt_class="line-clamp-3 md:line-clamp-4"
  image_loading="eager"
  }}
  {{/foreach}}
  {{/unless}}

  {{!-- Left column: 3 custom page cards --}}
  <div class="flex-1 flex flex-col gap-5 md:grid md:grid-cols-2 md:gap-0 lg:gap-5 lg:flex lg:flex-col lg:-order-1">

    <a href="https://6090-club.ghost.io/events/longevity/" class="flex flex-col gap-4 border-b border-brd-soft pb-5 md:border-b-0 md:border-r md:pr-4 lg:border-r-0 lg:border-b lg:pr-0 hover:opacity-90 transition-opacity">
      <figure class="block rounded-theme overflow-hidden">
        <img src="https://images.pexels.com/photos/4587346/pexels-photo-4587346.jpeg" alt="Longevity" class="w-full aspect-[16/9] object-cover rounded-[inherit]" loading="eager">
      </figure>
      <h3 class="text-lg font-semibold md:text-xl leading-tight md:leading-[1.15]">Longevity</h3>
    </a>

    <a href="https://6090-club.ghost.io/tag/health-wellness/" class="flex flex-col gap-4 md:ml-4 lg:ml-0 border-b border-brd-soft pb-5 lg:pb-5 hover:opacity-90 transition-opacity">
      <figure class="block rounded-theme overflow-hidden">
        <img src="https://images.pexels.com/photos/8939882/pexels-photo-8939882.jpeg" alt="Health &amp; Wellness" class="w-full aspect-[16/9] object-cover rounded-[inherit]" loading="eager">
      </figure>
      <h3 class="text-lg font-semibold md:text-xl leading-tight md:leading-[1.15]">Health &amp; Wellness</h3>
    </a>

    <a href="https://6090-club.ghost.io/games/" class="flex flex-col gap-4 md:ml-4 lg:ml-0 hover:opacity-90 transition-opacity">
      <figure class="block rounded-theme overflow-hidden">
        <img src="https://images.pexels.com/photos/8427636/pexels-photo-8427636.jpeg" alt="Games" class="w-full aspect-[16/9] object-cover rounded-[inherit]" loading="eager">
      </figure>
      <h3 class="text-lg font-semibold md:text-xl leading-tight md:leading-[1.15]">Games</h3>
    </a>

  </div>

  {{!-- Right column: 3 custom page cards --}}
  <div class="flex-1 flex flex-col gap-5 md:grid md:grid-cols-2 md:gap-0 lg:gap-5 lg:flex lg:flex-col">

    <a href="https://6090-club.ghost.io/tag/travel/" class="flex flex-col gap-4 border-b border-brd-soft pb-5 md:border-b-0 md:border-r md:pr-4 lg:border-r-0 lg:border-b lg:pr-0 hover:opacity-90 transition-opacity">
      <figure class="block rounded-theme overflow-hidden">
        <img src="https://images.pexels.com/photos/4201121/pexels-photo-4201121.jpeg" alt="Travel" class="w-full aspect-[16/9] object-cover rounded-[inherit]" loading="eager">
      </figure>
      <h3 class="text-lg font-semibold md:text-xl leading-tight md:leading-[1.15]">Travel</h3>
    </a>

    <a href="https://6090-club.ghost.io/tag/leisure/" class="flex flex-col gap-4 md:ml-4 lg:ml-0 border-b border-brd-soft pb-5 lg:pb-5 hover:opacity-90 transition-opacity">
      <figure class="block rounded-theme overflow-hidden">
        <img src="https://images.pexels.com/photos/38856572/pexels-photo-38856572.jpeg" alt="Leisure" class="w-full aspect-[16/9] object-cover rounded-[inherit]" loading="eager">
      </figure>
      <h3 class="text-lg font-semibold md:text-xl leading-tight md:leading-[1.15]">Leisure</h3>
    </a>

    <a href="URL_FOR_SIXTH_CARD" class="flex flex-col gap-4 md:ml-4 lg:ml-0 hover:opacity-90 transition-opacity">
      <figure class="block rounded-theme overflow-hidden">
        <img src="https://images.pexels.com/photos/39360612/pexels-photo-39360612.jpeg" alt="Sixth card" class="w-full aspect-[16/9] object-cover rounded-[inherit]" loading="eager">
      </figure>
      <h3 class="text-lg font-semibold md:text-xl leading-tight md:leading-[1.15]">Sixth Card Title</h3>
    </a>

  </div>
</div>